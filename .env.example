# Copy this file to .env and fill in real values. Never commit .env.

PORT=5000
NODE_ENV=development

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/coupon-share

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Your deployed frontend's URL (e.g. https://coupon-share.vercel.app).
# Leave blank in local development to allow any origin.
FRONTEND_URL=
